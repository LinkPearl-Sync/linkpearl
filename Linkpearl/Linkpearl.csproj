<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.1.1</Version>
    <AssemblyName>Linkpearl</AssemblyName>
  </PropertyGroup>

  <!-- Les API de Penumbra et Glamourer sont des dépendances du plugin, pas du
       noyau : elles n'ont rien à faire dans Core.Deps.props, que les tests
       importent aussi. -->
  <ItemGroup>
    <PackageReference Include="Penumbra.Api" Version="5.19.2" />
    <PackageReference Include="Glamourer.Api" Version="2.8.2" />

    <!-- DPAPI. Windows uniquement, donc surtout pas dans Core.Deps.props, que
         les tests importent et qui doivent tourner sous Linux. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <!-- Inter, sous-ensemblé, embarqué. Sous licence SIL OFL, dont le texte
       accompagne les fichiers. Les noms logiques sont ceux que Fonts.cs
       demande à l'assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\Inter-Regular.ttf"  LogicalName="Fonts.Inter-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Inter-SemiBold.ttf" LogicalName="Fonts.Inter-SemiBold.ttf" />
  </ItemGroup>

  <Import Project="..\build\Core.Deps.props" />

</Project>
